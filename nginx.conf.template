worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 2048; }

http {
    access_log /dev/stdout;
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen ${PORT} ssl;
        http2 on;
        server_name _;

        ssl_certificate ${SSL_CERT_FILE};
        ssl_certificate_key ${SSL_KEY_FILE};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;

        # Xray VLESS/VMess WebSocket transport.
        # TLS terminates at Nginx; Xray must use WS without TLS internally.
        location = ${NODE_WS_PATH} {
            proxy_pass http://127.0.0.1:${NODE_WS_PORT};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        # PasarGuard Node gRPC API. Nginx re-encrypts to the internal
        # self-signed gRPC listener; the panel still sees the public cert.
        location / {
            grpc_pass grpcs://127.0.0.1:${SERVICE_PORT};
            grpc_ssl_verify off;
            grpc_set_header x-api-key $http_x_api_key;
            grpc_set_header Host $host;
        }
    }
}
